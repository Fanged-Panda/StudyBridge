generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                   String                  @id @default(cuid())
  name                 String                  @db.VarChar(100)
  email                String                  @unique @db.VarChar(255)
  password             String?                 @db.VarChar(255)
  googleId             String?                 @unique
  phone                String?                 @db.VarChar(20)
  country              String                  @db.VarChar(100)
  institution          String?                 @db.VarChar(150)
  subject              String?                 @db.VarChar(100)
  cgpa                 Float?
  preferredSubject     String?                 @db.VarChar(100)
  satScore             Int?
  ieltsScore           Float?
  greScore             Int?
  toeflScore           Int?
  duolingoScore        Int?
  targetDegree         String?                 @db.VarChar(100)
  targetIntake         String?                 @db.VarChar(50)
  targetCountry        String?                 @db.VarChar(150)
  fundingPreference    String?                 @db.VarChar(100)
  graduationYear       Int?
  researchInterests    String?                 @db.VarChar(255)
  publicationsCount    Int?                    @default(0)
  workExperienceYears  Float?
  linkedinUrl          String?                 @db.VarChar(255)
  githubUrl            String?                 @db.VarChar(255)
  researchGateUrl      String?                 @db.VarChar(255)
  statementOfPurpose   String?                 @db.Text
  profileImage         String?                 @db.VarChar(255)
  role                 String                  @default("student") @db.VarChar(20)
  dailyGoal            Int                     @default(3) // new words the student wants to learn per day
  createdAt            DateTime                @default(now())
  followedUniversities FollowedUniversity[]
  notifications        Notification[]
  learnedWords         LearnedWord[]
  vocabularyTests      VocabularyTestAttempt[]
  journeys             Journey[]
  journeyVotes         JourneyVote[]
}

model University {
  id                   String               @id @default(cuid())
  name                 String               @unique @db.VarChar(150)
  country              String               @db.VarChar(100)
  city                 String?              @db.VarChar(100)
  ranking              Int
  tuitionAnnualUsd     Int?
  acceptanceRate       Float?
  applicationFee       Int?
  applicationDeadline  String?              @db.VarChar(100)
  ieltsRequirement     Float?
  greRequirement       Int?
  websiteUrl           String?              @db.VarChar(255)
  courses              Json?
  lastScraped          DateTime?
  lastSyncedAt         DateTime?
  nextSyncAt           DateTime?
  professorsNextSyncAt DateTime?
  syncStatus           String?              @db.VarChar(30)
  syncError            String?              @db.Text
  adminVerifiedAt      DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  followers            FollowedUniversity[]
  notifications        Notification[]
  professors           Professor[]

  @@index([nextSyncAt])
  @@index([professorsNextSyncAt])
}

// Faculty directory: who teaches what, at which university.
model Professor {
  id               String     @id @default(cuid())
  name             String     @db.VarChar(120)
  title            String     @db.VarChar(80)
  department       String?    @db.VarChar(120)
  field            String     @db.VarChar(140)
  bio              String?    @db.Text
  email            String?    @db.VarChar(180)
  profileUrl       String?    @db.VarChar(300)
  photoUrl         String?    @db.VarChar(300)
  openAlexId       String?    @db.VarChar(300)
  worksCount       Int?
  citedByCount     Int?
  hIndex           Int?
  topics           Json?
  universityId     String
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  lastSyncedAt     DateTime?
  nextSyncAt       DateTime?
  metricsUpdatedAt DateTime?
  syncStatus       String?    @db.VarChar(30)
  syncError        String?    @db.Text
  adminVerifiedAt  DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([universityId, openAlexId])
  @@index([name, universityId])
  @@index([universityId])
  @@index([field])
  @@index([openAlexId])
  @@index([nextSyncAt])
}

model Scholarship {
  id              String    @id @default(cuid())
  name            String    @unique @db.VarChar(150)
  country         String    @db.VarChar(100)
  amountUsd       Int?
  fundingLevel    String    @db.VarChar(50)
  eligibility     String?
  deadline        String?   @db.VarChar(100)
  websiteUrl      String?   @db.VarChar(255)
  lastScraped     DateTime?
  sourceUrl       String?   @db.VarChar(500)
  sourceName      String?   @db.VarChar(160)
  contentHash     String?   @db.VarChar(64)
  status          String    @default("NEEDS_VERIFICATION") @db.VarChar(30)
  lastFetchedAt   DateTime?
  lastExtractedAt DateTime?
  lastVerifiedAt  DateTime?
  lastSyncedAt    DateTime?
  nextSyncAt      DateTime?
  syncStatus      String?   @db.VarChar(30)
  syncError       String?   @db.Text
  confidence      Float?
  adminVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([nextSyncAt])
}

// Configured scholarship source pages, tracked independently from the programs
// extracted from them so content changes can be detected before using Gemini.
model ScholarshipSource {
  id              String    @id @default(cuid())
  url             String    @unique @db.VarChar(500)
  name            String?   @db.VarChar(160)
  country         String?   @db.VarChar(100)
  contentHash     String?   @db.VarChar(64)
  lastFetchedHash String?   @db.VarChar(64)
  lastFetchedAt   DateTime?
  lastExtractedAt DateTime?
  lastVerifiedAt  DateTime?
  lastChangedAt   DateTime?
  needsExtraction Boolean   @default(true)
  syncStatus      String?   @db.VarChar(30)
  syncError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([needsExtraction])
}

// Persistent administration/background job history. Type/status stay strings
// so new sync operations can be introduced without a database migration.
model SyncJob {
  id             String    @id @default(cuid())
  type           String    @db.VarChar(60)
  status         String    @default("QUEUED") @db.VarChar(30)
  triggeredBy    String    @default("manual") @db.VarChar(30)
  adminId        String?
  targetType     String?   @db.VarChar(30)
  targetId       String?   @db.VarChar(100)
  startedAt      DateTime?
  finishedAt     DateTime?
  processed      Int       @default(0)
  created        Int       @default(0)
  updated        Int       @default(0)
  unchanged      Int       @default(0)
  failed         Int       @default(0)
  skipped        Int       @default(0)
  error          String?   @db.Text
  details        Json?
  geminiRequests Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([type, status, targetId])
}

// Short-lived database locks shared by all backend instances.
model SyncLock {
  key       String   @id @db.VarChar(100)
  owner     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Application-level Gemini accounting. This is intentionally not treated as
// Google's official quota; it is a conservative shared budget.
model GeminiUsageDaily {
  day                 String    @id @db.VarChar(10)
  chatRequests        Int       @default(0)
  syncRequests        Int       @default(0)
  admissionRequests   Int       @default(0)
  scholarshipRequests Int       @default(0)
  quotaErrors         Int       @default(0)
  circuitOpenUntil    DateTime?
  lastQuotaErrorAt    DateTime?
  updatedAt           DateTime  @updatedAt
}

model FollowedUniversity {
  id           String     @id @default(cuid())
  userId       String
  universityId String
  createdAt    DateTime   @default(now())
  student      Student    @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([userId, universityId])
  @@index([userId])
  @@index([universityId])
}

model LearnedWord {
  id           String   @id @default(cuid())
  userId       String
  word         String   @db.VarChar(80)
  phonetic     String?  @db.VarChar(80)
  partOfSpeech String?  @db.VarChar(40)
  definition   String   @db.Text
  example      String?  @db.Text
  synonyms     Json?
  knewIt       Boolean  @default(false)
  learnedOnKey String   @db.VarChar(10)
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, learnedOnKey])
  @@index([userId, createdAt])
}

model VocabularyTestAttempt {
  id        String   @id @default(cuid())
  userId    String
  total     Int
  correct   Int
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id           String      @id @default(cuid())
  userId       String
  universityId String?
  title        String      @db.VarChar(200)
  message      String      @db.Text
  type         String      @db.VarChar(50)
  isRead       Boolean     @default(false)
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  student      Student     @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([universityId])
}

// Community: member-written journeys, moderated before they go public.
// Author emails live here and are never returned by public endpoints.
model Journey {
  id             String            @id @default(cuid())
  slug           String            @unique @db.VarChar(160)
  title          String            @db.VarChar(140)
  excerpt        String            @db.VarChar(320)
  story          String            @db.Text
  authorName     String            @db.VarChar(100)
  authorEmail    String            @db.VarChar(255)
  photoData      String?           @db.Text
  tags           String[]
  allowContact   Boolean           @default(true)
  authorId       String?
  status         String            @default("pending") @db.VarChar(20)
  moderationNote String?           @db.VarChar(300)
  views          Int               @default(0)
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reports        JourneyReport[]
  contacts       JourneyContact[]
  editLinks      JourneyEditLink[]
  comments       JourneyComment[]
  votes          JourneyVote[]
  author         Student?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, approvedAt])
  @@index([status, createdAt])
  @@index([authorEmail])
  @@index([authorId])
}

// One vote per member per post: value is 1 (up) or -1 (down).
model JourneyVote {
  id        String   @id @default(cuid())
  journeyId String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([journeyId, userId])
  @@index([journeyId])
  @@index([userId])
}

model JourneyReport {
  id            String   @id @default(cuid())
  journeyId     String
  reason        String   @db.VarChar(60)
  details       String?  @db.VarChar(1000)
  reporterEmail String?  @db.VarChar(255)
  status        String   @default("open") @db.VarChar(20)
  createdAt     DateTime @default(now())
  journey       Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([status, createdAt])
}

model JourneyContact {
  id          String   @id @default(cuid())
  journeyId   String
  senderName  String   @db.VarChar(100)
  senderEmail String   @db.VarChar(255)
  message     String   @db.Text
  delivered   Boolean  @default(false)
  createdAt   DateTime @default(now())
  journey     Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
}

// Reader comments on a published journey. One level of replies, like a forum.
model JourneyComment {
  id         String           @id @default(cuid())
  journeyId  String
  parentId   String?
  authorName String           @db.VarChar(60)
  body       String           @db.Text
  createdAt  DateTime         @default(now())
  journey    Journey          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  parent     JourneyComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    JourneyComment[] @relation("CommentReplies")

  @@index([journeyId, createdAt])
  @@index([parentId])
}

// Only a SHA-256 hash of the magic-link token is stored.
model JourneyEditLink {
  id        String   @id @default(cuid())
  journeyId String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
}

// One-time codes for "forgot password". Only a bcrypt hash of the code is
// stored, so a database leak can not be used to take over an account.
model PasswordResetCode {
  id         String    @id @default(cuid())
  email      String    @db.VarChar(255)
  codeHash   String    @db.VarChar(255)
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}
