PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# Neon Pooled Connection String (for running your app)
DATABASE_URL="postgresql://neondb_owner:your_password@your-host-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon Direct Connection String (for schema migrations)
DIRECT_URL="postgresql://neondb_owner:your_password@your-host.neon.tech/neondb?sslmode=require&channel_binding=require"

# Groq AI (required for AI chatbot — free at console.groq.com)
GROQ_API_KEY='your-groq-api-key'
# Optional: override the default model (llama-3.3-70b-versatile)
# GROQ_MODEL='llama-3.3-70b-versatile'

# ---- Community (journeys, contact emails, magic links) ----
# Resend API key: https://resend.com/api-keys (re_...). Leave blank locally to log emails instead of sending.
RESEND_API_KEY=''
# Verified sender, e.g. "StudyBridge <community@yourdomain.com>". Required when RESEND_API_KEY is set.
EMAIL_FROM='StudyBridge <onboarding@resend.dev>'
# Public URL of the frontend, used to build author magic links.
PUBLIC_APP_URL='http://localhost:5173'
