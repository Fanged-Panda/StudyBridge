PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# Neon Pooled Connection String (for running your app)
DATABASE_URL="postgresql://neondb_owner:your_password@your-host-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon Direct Connection String (for schema migrations)
DIRECT_URL="postgresql://neondb_owner:your_password@your-host.neon.tech/neondb?sslmode=require&channel_binding=require"

# Groq AI (required for AI chatbot — free at console.groq.com)
GROQ_API_KEY='your-groq-api-key'

# ---- Live data sync ----
# Gemini powers scholarship + admissions extraction from official pages.
GEMINI_API_KEY='your-gemini-api-key'
# GEMINI_MODEL='gemini-3.5-flash'

# ---- Gemini free-tier protection ----
# Sync extraction has a separate, conservative application-level budget.
# This is NOT Google's official quota; counters are shared across API keys.
GEMINI_CHAT_ENABLED=true
GEMINI_SYNC_ENABLED=true
GEMINI_SYNC_DAILY_LIMIT=10
GEMINI_SYNC_MAX_CONCURRENT=1
GEMINI_SYNC_PRIORITY=low
GEMINI_CIRCUIT_OPEN_MINUTES=60
GEMINI_SYNC_MAX_RETRIES=1
GEMINI_SYNC_RETRY_BASE_MS=750

# HipoLabs university directory (free, no key).
HIPOLABS_COUNTRIES='United States,United Kingdom,Canada,Germany,Australia,Bangladesh'
HIPOLABS_LIMIT_PER_COUNTRY=10
# Enrich matching records only. Set true to import universities missing from your DB.
HIPOLABS_CREATE_NEW=false
# New directory entries start below curated universities.
HIPOLABS_DEFAULT_RANKING=9999

# OpenAlex (free; mailto joins the polite pool, key is optional).
OPENALEX_MAILTO='you@example.com'
OPENALEX_API_KEY=''
OPENALEX_SYNC_UNIVERSITIES=10
OPENALEX_AUTHORS_PER_UNIVERSITY=20
OPENALEX_CONCURRENCY=4

# ---- Synchronization schedules / controlled batches ----
# Render Cron Jobs invoke the scripts in backend/scripts. These batch limits
# prevent one job from consuming the whole Gemini budget or OpenAlex rate limit.
ENABLE_IN_PROCESS_SCHEDULER=false
SYNC_UNIVERSITY_INTERVAL_DAYS=30
SYNC_ADMISSIONS_INTERVAL_DAYS=30
SYNC_PROFESSORS_INTERVAL_DAYS=30
SYNC_RESEARCH_INTERVAL_DAYS=30
SYNC_ADMISSIONS_BATCH=10
SYNC_PROFESSORS_BATCH=3
SYNC_METRICS_BATCH_UNIVERSITIES=3
SYNC_SCHOLARSHIP_EXTRACT_BATCH=5
SYNC_QUEUE_BATCH=5
SYNC_MANUAL_COOLDOWN_SECONDS=10
GEMINI_AUTO_SYNC_ENABLED=false

# Optional override: "https://page|Country,https://page2|Country"
SCHOLARSHIP_SOURCE_URLS=''
# Optional: override the default model (llama-3.3-70b-versatile)
# GROQ_MODEL='llama-3.3-70b-versatile'

# ---- Email (password-reset codes, community contact emails, magic links) ----
# All outbound mail is sent over SMTP. Leave SMTP_USER / SMTP_PASS blank locally
# to log emails instead of sending them.
# Set USE_SMTP=false to disable SMTP sending explicitly.
USE_SMTP=true
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=587
# Optional: "true" for implicit TLS (port 465). Defaults to true when SMTP_PORT=465.
# SMTP_SECURE=false
SMTP_USER='your-email@gmail.com'
# Gmail requires an App Password (Google Account → Security → App passwords).
SMTP_PASS='your-app-password'
# Optional visible sender. Defaults to "StudyBridge <SMTP_USER>".
# SMTP_FROM='StudyBridge <your-email@gmail.com>'
# Public URL of the frontend, used to build author magic links.
PUBLIC_APP_URL='http://localhost:5173'
