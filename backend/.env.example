PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# Neon Pooled Connection String (for running your app)
DATABASE_URL="postgresql://neondb_owner:your_password@your-host-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon Direct Connection String (for schema migrations)
DIRECT_URL="postgresql://neondb_owner:your_password@your-host.neon.tech/neondb?sslmode=require&channel_binding=require"

# Groq AI (required for AI chatbot — free at console.groq.com)
GROQ_API_KEY='your-groq-api-key'
# Optional: override the default model (llama-3.3-70b-versatile)
# GROQ_MODEL='llama-3.3-70b-versatile'

# ---- Email (password-reset codes, community contact emails, magic links) ----
# All outbound mail is sent over SMTP. Leave SMTP_USER / SMTP_PASS blank locally
# to log emails instead of sending them.
# Set USE_SMTP=false to disable SMTP sending explicitly.
USE_SMTP=true
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=587
# Optional: "true" for implicit TLS (port 465). Defaults to true when SMTP_PORT=465.
# SMTP_SECURE=false
SMTP_USER='your-email@gmail.com'
# Gmail requires an App Password (Google Account → Security → App passwords).
SMTP_PASS='your-app-password'
# Optional visible sender. Defaults to "StudyBridge <SMTP_USER>".
# SMTP_FROM='StudyBridge <your-email@gmail.com>'
# Public URL of the frontend, used to build author magic links.
PUBLIC_APP_URL='http://localhost:5173'
